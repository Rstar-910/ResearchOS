DATABASE_URL=sqlite:///./researchos.db
DISCOVERY_ENABLED=true
# Request your own key: https://www.semanticscholar.org/product/api#api-key-form
# Optional, but anonymous Semantic Scholar requests can be heavily rate-limited.
SEMANTIC_SCHOLAR_API_KEY=
# Optional web search; the instance must enable search.formats: [html, json].
# SEARXNG_URL=http://localhost:8080
# Empty is allowed; only set a URL for a running SearXNG instance.
SEARXNG_URL=
SEARCH_TIMEOUT=30
# Model for planning. Create a key at https://ollama.com/settings/keys for Ollama Cloud,
# or leave the key empty and set OLLAMA_BASE_URL=http://localhost:11434 for local Ollama.
# With neither set, ResearchOS uses its template plan and calls no model.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
LLM_MODEL=gpt-oss:120b
# Embeddings for passage search, from a local Ollama server (ollama pull the models first).
# Unset means passages are searchable by keyword only.
# EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_FALLBACK_MODEL=nomic-embed-text
# PostgreSQL alternative (start with docker compose up -d postgres):
# DATABASE_URL=postgresql+psycopg://researchos:researchos@localhost:5432/researchos
